{
  "name": "@libre-ai/governance",
  "version": "0.0.0",
  "private": true,
  "license": "EUPL-1.2",
  "type": "module",
  "packageManager": "bun@1.4.0-canary.1",
  "engines": {
    "bun": ">=1.4.0"
  },
  "overrides": {
    "fast-uri": "4.1.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "entities": "8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "scripts": {
    "check:bun:runtime": "bun tools/quality/check-bun-minimum.ts",
    "check:bun": "bun run check:bun:runtime && bun tools/quality/check-bun-manifests.ts",
    "check:source": "bun run check:bun:runtime && bun tools/quality/check-source-policy.ts",
    "check:names": "bun run check:bun:runtime && bun tools/quality/check-retired-names.ts",
    "check:forgotten": "bun run check:bun:runtime && bun tools/quality/check-forgotten.ts",
    "check:cards": "bun run check:bun:runtime && bun ecosystem/validate-cards.ts",
    "check:objects": "bun run check:bun:runtime && bun tools/quality/validate-knowledge-objects.ts",
    "check:objectives": "bun run check:bun:runtime && bun tools/quality/check-objectives.ts",
    "check:specifications": "bun run check:bun:runtime && bun tools/quality/check-specification-lock.ts",
    "check:licenses": "bun run check:bun:runtime && bun tools/quality/check-js-licenses.ts",
    "check:dead-code": "bun run check:bun:runtime && bun tools/quality/check-dead-code.ts",
    "lint": "bun run check:bun:runtime && biome ci .",
    "typecheck": "bun run check:bun:runtime && tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "check": "bun run check:bun && bun run check:toolchain && bun run check:source && bun run check:names && bun run check:forgotten && bun run check:cards && bun run check:objects && bun run check:objectives && bun run check:specifications && bun run check:licenses && bun run check:dead-code && bun run lint && bun run typecheck && bun test",
    "pretest": "bun run check:bun",
    "check:bun-snapshot": "bun run check:bun:runtime && bun tools/quality/verify-bun-snapshot.ts",
    "check:toolchain": "bun run check:bun && bun tools/quality/check-toolchain.ts"
  }
}
